# Copy this file to ".env" and fill in your own values
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (add the database name "imovies" after .net/)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/imovies?retryWrites=true&w=majority

# Any long random string
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed by CORS, comma separated, no trailing slash
CLIENT_URL=http://localhost:5173

# How long selected seats stay held during payment (minutes)
LOCK_MINUTES=8
# Bookings can be cancelled until this many hours before the show
CANCEL_WINDOW_HOURS=2
